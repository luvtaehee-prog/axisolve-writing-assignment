{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "installCommand": null,

  "functions": {
    "api/generate.py": {
      "maxDuration": 60,
      "includeFiles": "api/_*.py"
    },
    "api/me.py": {
      "maxDuration": 30,
      "includeFiles": "api/_*.py"
    },
    "api/redeem.py": {
      "maxDuration": 30,
      "includeFiles": "api/_*.py"
    },
    "api/topics.py": {
      "maxDuration": 15,
      "includeFiles": "api/_*.py"
    },
    "api/pdf.py": {
      "maxDuration": 30,
      "includeFiles": "api/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/_:path*",
      "destination": "/blocked-404"
    }
  ]
}
