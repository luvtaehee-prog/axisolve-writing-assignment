# 로컬 개발용 (vercel dev / dev_server.py). 실제 배포 시에는 Vercel 환경변수에 등록한다.
OPENAI_API_KEY=sk-...

# 선택: 기본값 gpt-5.6-terra (sol=최상위 / terra=균형 / luna=저비용)
# OPENAI_MODEL=gpt-5.6-luna
# 선택: 기본값 medium
# OPENAI_REASONING_EFFORT=medium

# ---------- Phase 1 비용 방어 (api/_guard.py) ----------
# 허용할 출처. 콤마로 구분. 비워 두면 출처 검사를 하지 않는다(로컬 개발).
# 배포 시 반드시 지정할 것 — 이걸 비워 두면 누구나 외부에서 호출할 수 있다.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# IP 해시를 만들 때 쓰는 솔트. 지정하지 않으면 재시작마다 카운터가 초기화된다.
# 아무 긴 임의 문자열이면 된다.
# IP_SALT=

# 상한. 0 이면 해당 검사를 끈다.
# RATE_LIMIT_IP_HOURLY=12
# RATE_LIMIT_IP_DAILY=30
# RATE_LIMIT_GLOBAL_DAILY=500
#
# [무료 공개 모드 주의] Supabase 를 설정하지 않은 상태로 배포하면 로그인·크레딧이
# 없으므로 생성이 사실상 무제한이 된다. 이때 비용을 막는 것은 아래 전역 상한뿐이다.
#   500회/일 → 최악(전부 초5-6) 월 약 21만원
#   150회/일 → 최악 월 약 6.3만원
#   100회/일 → 최악 월 약 4.2만원
# 무료로 먼저 열어 반응을 볼 계획이라면 100~150 으로 낮춰 시작할 것.

# ---------- Phase 2 로그인·크레딧 (api/_supabase.py) ----------
# 셋 다 비워 두면 로그인 계층 전체가 꺼지고 Phase 1 상태로 동작한다.
# Supabase 대시보드 > Project Settings > API 에서 확인한다.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGci...          (공개되어도 되는 키)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...  (절대 브라우저에 노출 금지)

# 가입 보너스 크레딧 (기본 3)
# SIGNUP_BONUS_CREDITS=3
# 비회원 무료 체험 횟수 (기본 2)
# FREE_ANON_USES=2
# 비회원 IP 하나당 하루 상한. 공용 IP(학원·학교)를 고려해 넉넉히 잡는다 (기본 10)
# ANON_IP_DAILY=10

# ---------- 충전 코드제 (api/redeem.py) — 사업자등록 전 임시 결제 경로 ----------
# 크레딧 부족 안내창에 표시할 문의처. 오픈채팅·카카오채널·메일 주소 등.
# 비워 두면 "관리자에게 문의해 주십시오" 문구만 나온다.
# PURCHASE_CONTACT=https://open.kakao.com/o/xxxxxxx

# 안내창에 표시할 입금 계좌. 비워 두면 표시하지 않는다.
# PURCHASE_BANK=국민은행 123456-78-901234 (예금주: 홍길동)

# 코드 무차별 대입 방어 — IP당 시간당 시도 횟수 (기본 10)
# REDEEM_TRIES_HOURLY=10
